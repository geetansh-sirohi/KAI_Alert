# ==============================================================================
# KAI Alert — Production Leak-Proof .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# Environment Variables & Secrets (CRITICAL: NEVER LEAK API KEYS)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Testing & Coverage
/coverage

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Cloud CLI
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.turbo

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Certificates & Keys
*.pem
*.key
*.cert
